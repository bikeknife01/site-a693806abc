{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dragonfire.local/schemas/player-roster-v1.schema.json",
  "title": "Dragonfire evidence-aware player roster",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "observed_at",
    "source",
    "roster_preflight",
    "knowledge",
    "ingestion",
    "profile",
    "evidence",
    "review"
  ],
  "properties": {
    "schema_version": { "const": "dragonfire.player-roster.v1" },
    "profile_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "observed_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "inputs", "field_treatment"],
      "properties": {
        "kind": { "enum": ["formation_forge_export", "screenshot_transcription"] },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        },
        "field_treatment": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_field", "treatment"],
            "properties": {
              "source_field": { "type": "string" },
              "treatment": { "type": "string" }
            }
          }
        }
      }
    },
    "roster_preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completeness", "expected_visible_dragons", "observed_dragons"],
      "properties": {
        "completeness": { "enum": ["complete", "declared_subset"] },
        "expected_visible_dragons": { "type": ["integer", "null"], "minimum": 0 },
        "observed_dragons": { "type": "integer", "minimum": 0 }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "dataset_schema_version", "dataset_sha256", "game_mechanics_sha256", "client_versions", "source_manifest"],
      "properties": {
        "dataset_id": { "type": "string" },
        "dataset_schema_version": { "type": "string" },
        "dataset_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "game_mechanics_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "client_versions": { "type": "object" },
        "source_manifest": { "type": "array" }
      }
    },
    "ingestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "tool_version"],
      "properties": {
        "tool": { "const": "projects/roster-ingestion" },
        "tool_version": { "type": "string" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "updated_at", "stronghold", "dragons"],
      "properties": {
        "version": { "const": 3 },
        "updated_at": { "type": "string", "format": "date-time" },
        "stronghold": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dragons_army"],
          "properties": {
            "dragons_army": { "$ref": "#/$defs/dragonsArmy" }
          }
        },
        "dragons": {
          "type": "object",
          "propertyNames": { "pattern": "^dragon_(generic|iconic)_[a-z0-9_]+$" },
          "additionalProperties": { "$ref": "#/$defs/profileEntry" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/evidence" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "errors", "warnings", "conflicts"],
      "properties": {
        "status": { "enum": ["ready", "needs_review", "blocked"] },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "conflicts": { "type": "array", "items": { "$ref": "#/$defs/issue" } }
      }
    }
  },
  "$defs": {
    "dragonsArmy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_skill",
        "current_skill_name",
        "current_level",
        "troops_per_level",
        "completed_prior_skills_bonus_per_dragon",
        "current_skill_bonus_per_dragon",
        "additional_troops_per_dragon",
        "additional_troops_per_three_dragon_formation",
        "provenance",
        "basis"
      ],
      "properties": {
        "current_skill": { "enum": ["none", "I", "II", "III", "IV"] },
        "current_skill_name": { "type": ["string", "null"] },
        "current_level": { "type": "integer", "minimum": 0, "maximum": 5 },
        "troops_per_level": { "enum": [0, 50, 100, 200, 250] },
        "completed_prior_skills_bonus_per_dragon": { "type": "integer", "minimum": 0 },
        "current_skill_bonus_per_dragon": { "type": "integer", "minimum": 0 },
        "additional_troops_per_dragon": { "type": "integer", "minimum": 0 },
        "additional_troops_per_three_dragon_formation": { "type": "integer", "minimum": 0 },
        "provenance": { "enum": ["observed", "assumed"] },
        "basis": { "enum": ["user_declaration", "screenshot_transcription", "ingestion_default"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "name", "sha256", "size_bytes"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "name": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "profileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owned", "include_in_search", "level", "stars", "displayed_stars", "power", "troop_capacity", "habit_levels", "assumed"],
      "properties": {
        "owned": { "type": ["boolean", "null"] },
        "include_in_search": { "type": ["boolean", "null"] },
        "level": { "type": ["integer", "null"], "minimum": 1, "maximum": 50 },
        "stars": { "type": ["integer", "null"], "minimum": 1, "maximum": 10 },
        "displayed_stars": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["color", "count"],
              "properties": {
                "color": { "enum": ["yellow", "red"] },
                "count": { "type": "integer", "minimum": 1, "maximum": 5 }
              }
            }
          ]
        },
        "power": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "troop_capacity": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "habit_levels": {
          "type": "object",
          "propertyNames": { "pattern": "^habit_" },
          "additionalProperties": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 }
        },
        "assumed": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "field", "provenance", "raw_value", "normalized_value", "confidence", "review_status", "crop", "note"],
      "properties": {
        "source_id": { "type": "string" },
        "field": { "type": "string" },
        "provenance": { "enum": ["observed", "derived", "assumed", "unknown"] },
        "raw_value": {},
        "normalized_value": {},
        "confidence": { "enum": ["low", "medium", "high", "confirmed"] },
        "review_status": { "enum": ["machine_read", "confirmed", "corrected", "conflicting", "unreadable"] },
        "crop": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number", "minimum": 0 },
            "y": { "type": "number", "minimum": 0 },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "note": { "type": ["string", "null"] }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": true,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "enum": ["error", "warning", "info"] },
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
