{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "combat-report-observations.schema.json",
  "title": "Dragonfire combat report observation store",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "observations"],
  "properties": {
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "updated"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "disposition", "report", "location", "verbatim", "normalized", "quality"],
        "properties": {
          "id": {"type": "string", "pattern": "^observation\\.[a-z0-9][a-z0-9.-]*\\.[0-9]{3,}$"},
          "disposition": {"enum": ["supports", "contradicts", "context"]},
          "report": {
            "type": "object", "additionalProperties": false,
            "required": ["report_id", "capture_date", "client_version", "extractor_schema_version"],
            "properties": {
              "report_id": {"type": "string", "minLength": 1},
              "capture_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
              "client_version": {"type": ["string", "null"]},
              "extractor_schema_version": {"const": "1.0.0"},
              "formation_id": {"type": ["string", "null"]}
            }
          },
          "location": {
            "type": "object", "additionalProperties": false,
            "required": ["round", "timestamp_seconds", "frame_basename"],
            "properties": {
              "round": {"type": ["integer", "null"], "minimum": 1},
              "timestamp_seconds": {"type": ["number", "null"], "minimum": 0},
              "frame_basename": {"type": ["string", "null"]}
            }
          },
          "verbatim": {
            "type": "object", "additionalProperties": false,
            "required": ["head_text", "detail_text"],
            "properties": {"head_text": {"type": "string"}, "detail_text": {"type": "string"}}
          },
          "normalized": {
            "type": "object", "additionalProperties": false,
            "required": ["owner", "actor", "ability", "result"],
            "properties": {
              "owner": {"enum": ["user", "enemy", "unknown"]},
              "actor": {"type": ["string", "null"]},
              "ability": {"type": ["string", "null"]},
              "result": {"type": ["string", "null"]}
            }
          },
          "quality": {
            "type": "object", "additionalProperties": false,
            "required": ["visual_review", "coverage_warnings_relevant", "notes"],
            "properties": {
              "visual_review": {"enum": ["confirmed", "pending", "rejected"]},
              "coverage_warnings_relevant": {"type": "boolean"},
              "notes": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
